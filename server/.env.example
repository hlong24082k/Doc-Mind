# ==========================================
# Project Information
# ==========================================
NAME="Doc-Mind"
VERSION="0.1.0"
DESCRIPTION="Doc-Mind API Server"
AUTHOR="Doc-Mind Team"
DEBUG=true

# ==========================================
# Server Configuration
# ==========================================
HOST="0.0.0.0"
PORT=8000

# ==========================================
# Security & JWT Settings
# ==========================================
JWT_SECRET_KEY="your-super-secret-jwt-key"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="docmind"

# ==========================================
# Seed Admin User
# ==========================================
FIRST_SUPERUSER="admin"
FIRST_SUPERUSER_PASSWORD="Admin@123456"

# ==========================================
# Storage Configuration
# ==========================================
DOCUMENTS_FOLDER="./documents"

# ==========================================
# Google Gemini API (embedding)
# ==========================================
GEMINI_API_KEY="your-gemini-api-key-here"

# ==========================================
# LLM (OpenAI-compatible Chat Completions)
# ==========================================
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# vLLM:   http://localhost:8001/v1  (LLM_API_KEY tùy ý nếu không bật --api-key, vd. "EMPTY")
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_API_KEY="your-gemini-api-key-here"
LLM_MODEL="gemini-3.5-flash-lite"
# minimal | low | medium | high; để rỗng nếu model không hỗ trợ
LLM_REASONING_EFFORT="minimal"

# ==========================================
# RAG Core
# ==========================================
EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=6
EMBEDDING_QUERY_TASK="question answering"

CHUNK_TOKENIZER="answerdotai/ModernBERT-large"
CHUNK_TARGET_TOKENS=384
CHUNK_OVERLAP_TOKENS=64
CHUNK_MAX_TOKENS=512
CHUNK_MIN_TOKENS=64
CHUNK_INCLUDE_REFERENCES=false

RETRIEVAL_DENSE_K=50
RETRIEVAL_SPARSE_K=50
RETRIEVAL_RRF_K=60
RETRIEVAL_DENSE_WEIGHT=1.0
RETRIEVAL_SPARSE_WEIGHT=1.0
# số candidate xét ngưỡng dense trước khi cắt top_n
RETRIEVAL_CANDIDATES=30
RETRIEVAL_TOP_N=5
HNSW_EF_SEARCH=100
# cosine sim tối thiểu của chunk dense tốt nhất, thấp hơn → từ chối không gọi LLM (0 = tắt)
RETRIEVAL_MIN_DENSE_SCORE=0.65

# số chunk liền kề mỗi phía; 0 = tắt small-to-big (không query DB)
CONTEXT_WINDOW=1
CONTEXT_MAX_TOKENS=6000

# ==========================================
# Database pool
# ==========================================
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==========================================
# Uploads
# ==========================================
UPLOAD_MAX_MB=25
UPLOAD_MAX_FILES=10
# Content-Length tối đa của một request (reverse proxy: client_max_body_size >= giá trị này)
UPLOAD_MAX_REQUEST_MB=100
# số request upload xử lý đồng thời mỗi process (vượt → 503)
UPLOAD_MAX_CONCURRENCY=8
# volume DOCUMENTS_FOLDER còn ít hơn → 507
UPLOAD_MIN_FREE_MB=2048
USER_QUOTA_MB=500
USER_QUOTA_DOCUMENTS=100
# TMPDIR không phải setting: Python đọc nó lúc khởi động, nên phải đặt trong
# môi trường của process (shell / Docker), trỏ vào cùng volume với DOCUMENTS_FOLDER:
#   mkdir -p documents/.upload-tmp && export TMPDIR=$PWD/documents/.upload-tmp

# ==========================================
# Ingestion worker (Postgres queue)
# ==========================================
# false khi chạy scripts/ingest_worker.py thành process riêng
INGEST_WORKER_ENABLED=true
INGEST_CONCURRENCY=2
INGEST_POLL_INTERVAL_S=2.0
INGEST_MAX_ATTEMPTS=3
# job 'processing' quá hạn này (giây) → được claim lại
INGEST_STALE_AFTER_S=900

# ==========================================
# Chat
# ==========================================
CHAT_MAX_CONCURRENCY=32
CHAT_QUEUE_TIMEOUT_S=10.0
CHAT_HISTORY_TURNS=3
CHAT_MESSAGE_MAX_CHARS=2000
CONVERSATION_MAX_DOCUMENTS=10
EMBEDDING_QUERY_MAX_RETRIES=2
QUERY_REWRITE_TIMEOUT_S=8.0
