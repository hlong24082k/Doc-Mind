# ==========================================
# Project Information
# ==========================================
NAME="Doc-Mind"
VERSION="0.1.0"
DESCRIPTION="Doc-Mind API Server"
AUTHOR="Doc-Mind Team"
DEBUG=true

# ==========================================
# Server Configuration
# ==========================================
HOST="0.0.0.0"
PORT=8000

# ==========================================
# Security & JWT Settings
# ==========================================
JWT_SECRET_KEY="your-super-secret-jwt-key"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="docmind"

# ==========================================
# Seed Admin User
# ==========================================
FIRST_SUPERUSER="admin"
FIRST_SUPERUSER_PASSWORD="Admin@123456"

# ==========================================
# Storage Configuration
# ==========================================
DOCUMENTS_FOLDER="./documents"

# ==========================================
# Google Gemini API Configuration
# ==========================================
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_THINKING_LEVEL="minimal"

# ==========================================
# RAG Core
# ==========================================
EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=6
EMBEDDING_QUERY_TASK="question answering"

CHUNK_TOKENIZER="answerdotai/ModernBERT-large"
CHUNK_TARGET_TOKENS=384
CHUNK_OVERLAP_TOKENS=64
CHUNK_MAX_TOKENS=512
CHUNK_MIN_TOKENS=64
CHUNK_INCLUDE_REFERENCES=false

RETRIEVAL_DENSE_K=50
RETRIEVAL_SPARSE_K=50
RETRIEVAL_RRF_K=60
RETRIEVAL_DENSE_WEIGHT=1.0
RETRIEVAL_SPARSE_WEIGHT=1.0
RETRIEVAL_CANDIDATES=30
HNSW_EF_SEARCH=100
# cosine sim tối thiểu của chunk dense tốt nhất, thấp hơn → từ chối không gọi LLM (0 = tắt)
RETRIEVAL_MIN_DENSE_SCORE=0.65

# laya | none (laya chỉ chạy trên Apple Silicon)
RERANKER="laya"
LAYA_MODEL="aac6fef/laya-typed-decisions-mlx"
LAYA_DTYPE="float16"
RERANK_TOP_N=5
RERANK_MIN_SCORE=0.10

# số chunk liền kề mỗi phía; 0 = tắt small-to-big (không query DB)
CONTEXT_WINDOW=1
CONTEXT_MAX_TOKENS=6000
